---
// src/components/DemoVideo.astro
import {YouTube} from 'astro-lazy-youtube-embed'
---
<div id="demo-video-wrapper" class="space-y-6 landing-section">
    <h1 class="text-3xl font-bold mb-6 text-center">Document Analysis Mode:</h1>
    <h3 class="text-1xl mt-0 mb-6 text-center">Mixed Text and Math, Multiple Target Languages, and Table Recognition</h3>
    <!-- <div> -->
    <!-- <video id="demo-video" src="https://www.youtube.com/embed/HI4ED2GQTwo" controls class="w-[50vw] rounded-lg shadow-lg"></video> -->
    <!-- </div> -->


    <YouTube
        title="FrameOCR Document Analysis Mode"
        videoId="lEujFhvotC0"
    />

    <h1 class="text-3xl font-bold mb-6 text-center">Basic Features:</h1>
    <h3 class="text-1xl mt-0 mb-6 text-center">Single Target Language and LaTeX Math Recognition</h3>
    
    <!-- <div>
    <video id="demo-video" src="/V1-Use-Cases.mp4" controls class="w-[50vw] rounded-lg shadow-lg"></video>
    </div> -->

    <YouTube
        title="FrameOCR Basic Use Cases"
        videoId="iDnPkviZqMU"
    />

</div>

<style>
    #demo-video-wrapper {
        padding: 10px;
    }

    #demo-video {
        width: 55vw;
        /* min-width: 550px; */
        margin: 0 auto;
    }

    /* For mobile screens */
    @media (max-width: 1000px) {
        #demo-video {
            width: 95%;
            min-width: auto; /* allow shrinking */
        }
    }

    #demo-subtitle {
        width: 50%;
        margin: 0 auto;
        padding: 10px;
        padding-bottom: 20px;
    }
</style>